# PatchHive monorepo

# Node / frontend
node_modules/
dist/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Rust
target/
# Workspace members share the tracked root lockfile. Product/crate/service
# lockfiles are generated only while preparing standalone exports.
/crates/*/Cargo.lock
/packages/*/rust-gateway/Cargo.lock
/products/*/backend/Cargo.lock
/services/*/Cargo.lock

# Local env / secrets
.env
.env.*
.env.local
.env.*.local
.backups/
!.env.example
.npmrc
.netrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
.aws/
.gh/

# Local databases and runtime files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pid

# Logs / temp
*.log
tmp/
.cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local tool state
.codex

# Nested standalone site checkout
patchhive-sites/

# In-progress PatchHive.dev website concept
unified-brand-vision-main/
.codegraph/
