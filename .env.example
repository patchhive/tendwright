# =============================================================================
# PatchHive unified environment
# =============================================================================
# Copy this file to .env at the repository root. Monorepo services and product
# binaries discover it automatically. Set PATCHHIVE_ENV_FILE to use a different
# canonical file. Existing process variables always override file values.

# ── Suite runtime ─────────────────────────────────────────────────────────────
PATCHHIVE_BIND_ADDR=127.0.0.1:8100
# Optional absolute path for the unified suite database. When unset, the
# backend creates patchhive-backend.db in its working directory.
# PATCHHIVE_DB_PATH=/absolute/path/to/patchhive.db
PATCHHIVE_PRODUCTS=all
PATCHHIVE_DB_POOL_SIZE=4
# SQLite lock waits are bounded so database contention cannot pin async workers.
# PATCHHIVE_DB_BUSY_TIMEOUT_MS=250
# Browser origins allowed to call suite HTTP APIs (comma-separated).
# PATCHHIVE_CORS_ORIGINS=http://localhost:5173,http://localhost:5183
# PATCHHIVE_ALLOW_REMOTE_AGGREGATES=false
# PATCHHIVE_RATE_LIMIT_MAX=300
# PATCHHIVE_RATE_LIMIT_SENSITIVE_MAX=30
# PATCHHIVE_RATE_LIMIT_WINDOW_SECS=60
# PATCHHIVE_TRUST_PROXY=false
# Compose runs backend containers as this non-root uid/gid by default.
PATCHHIVE_BACKEND_UID=10001
PATCHHIVE_BACKEND_GID=10001
RUST_LOG=info

# ── Suite authentication and encryption ──────────────────────────────────────
# Optional externally managed authority for trusted product/bootstrap coordination.
# Generate with: openssl rand -hex 32. When this is unset, HiveCore can generate
# and durably encrypt an authority using HIVECORE_ENCRYPTION_KEY.
# PATCHHIVE_SUITE_BOOTSTRAP_SECRET=
# Machine-random encryption key shared by products that encrypt local secrets.
# Generate with: openssl rand -hex 32
# PATCHHIVE_ENCRYPTION_KEY=
# PATCHHIVE_ALLOW_REMOTE_BOOTSTRAP=false
# Host launcher authentication. Generate a raw key with `openssl rand -hex 32`,
# put that value in PATCHHIVE_LAUNCHER_API_KEY, and put its SHA-256 digest in
# PATCHHIVE_LAUNCHER_API_KEY_HASH.
# PATCHHIVE_LAUNCHER_API_KEY=
# PATCHHIVE_LAUNCHER_API_KEY_HASH=
# Remote registry deployments require this key for install registration.
# PATCHHIVE_REGISTRY_REGISTRATION_KEY=
# Shared machine-random secret protecting the registry's repository-owner opt-out feed.
# Use the same raw value for PATCHHIVE_OPT_OUT_SYNC_KEY in HiveCore.
# PATCHHIVE_REGISTRY_OPT_OUT_SYNC_KEY=

# ── Shared GitHub read path ───────────────────────────────────────────────────
# Recommended classic PAT: public_repo for public-only PatchHive use, or repo
# when private repositories are in scope. Add security_events when protected
# code-scanning/security-event reads require it.
#
# GitHub's classic PAT scopes are not truly read-only: public_repo and repo can
# authorize writes. PatchHive constrains this credential to read-client code
# paths and never uses it as a fallback for publishing.
# PATCHHIVE_GITHUB_TOKEN_RO=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy compatibility only. Do not add these to new configurations.
# BOT_GITHUB_TOKEN=
# GITHUB_TOKEN=

# ── Product-specific GitHub write identities ─────────────────────────────────
# Publishing products must have their own explicit classic PAT. public_repo is
# recommended for public repositories; use repo only when private repositories
# are intentionally in scope. The shared read token never substitutes for these.
# MERGE_KEEPER_GITHUB_TOKEN_RW=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REVIEW_BEE_GITHUB_TOKEN_RW=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TRUST_GATE_GITHUB_TOKEN_RW=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REPO_REAPER_GITHUB_TOKEN_RW=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RepoReaper commit identity must match its write credential owner.
# BOT_GITHUB_USER=patchhive
# HIVE_CORE_GITHUB_WEBHOOK_SECRET=
# PATCHHIVE_GITHUB_BOT_LOGIN=patchhive
# BOT_GITHUB_EMAIL=000000+patchhive@users.noreply.github.com

# ── Product operator and service authentication ──────────────────────────────
# Browser/operator API-key hashes.
# SIGNAL_API_KEY_HASH=
# TRUST_API_KEY_HASH=
# REPO_MEMORY_API_KEY_HASH=
# REVIEW_BEE_API_KEY_HASH=
# MERGE_KEEPER_API_KEY_HASH=
# FLAKE_STING_API_KEY_HASH=
# DEP_TRIAGE_API_KEY_HASH=
# VULN_TRIAGE_API_KEY_HASH=
# REFACTOR_SCOUT_API_KEY_HASH=
# RELEASE_SENTRY_API_KEY_HASH=
# REAPER_API_KEY_HASH=
# HIVE_CORE_API_KEY_HASH=

# Peer-service token hashes for HiveCore and product-to-product dispatch.
# SIGNAL_SERVICE_TOKEN_HASH=
# TRUST_SERVICE_TOKEN_HASH=
# REPO_MEMORY_SERVICE_TOKEN_HASH=
# REVIEW_BEE_SERVICE_TOKEN_HASH=
# MERGE_KEEPER_SERVICE_TOKEN_HASH=
# FLAKE_STING_SERVICE_TOKEN_HASH=
# DEP_TRIAGE_SERVICE_TOKEN_HASH=
# VULN_TRIAGE_SERVICE_TOKEN_HASH=
# REFACTOR_SCOUT_SERVICE_TOKEN_HASH=
# RELEASE_SENTRY_SERVICE_TOKEN_HASH=
# REAPER_SERVICE_TOKEN_HASH=

# ── GitHub webhooks and report links ─────────────────────────────────────────
# MERGE_KEEPER_GITHUB_WEBHOOK_SECRET=
# MERGE_KEEPER_PUBLIC_URL=http://localhost:5178
# REVIEW_BEE_GITHUB_WEBHOOK_SECRET=
# REVIEW_BEE_PUBLIC_URL=http://localhost:5177
# TRUST_GITHUB_WEBHOOK_SECRET=
# TRUSTGATE_PUBLIC_URL=http://localhost:5175
# WEBHOOK_SECRET=

# ── Product integrations ──────────────────────────────────────────────────────
# PATCHHIVE_REPO_MEMORY_URL=http://localhost:8100/api/products/repo-memory
# PATCHHIVE_REPO_MEMORY_SERVICE_TOKEN=
# PATCHHIVE_REPO_MEMORY_API_KEY=
# PATCHHIVE_REVIEW_BEE_URL=http://localhost:8100/api/products/review-bee
# PATCHHIVE_REVIEW_BEE_SERVICE_TOKEN=
# PATCHHIVE_REVIEW_BEE_API_KEY=
# PATCHHIVE_TRUST_GATE_URL=http://localhost:8100/api/products/trust-gate
# PATCHHIVE_TRUST_GATE_SERVICE_TOKEN=
# PATCHHIVE_TRUST_GATE_API_KEY=
# PATCHHIVE_HIVECORE_URL=http://localhost:8080
# PATCHHIVE_HIVECORE_SERVICE_TOKEN=
# PATCHHIVE_HIVECORE_API_KEY=

# ── RepoReaper AI and execution ───────────────────────────────────────────────
# PROVIDER_API_KEY=
# Optional first-class OpenRouter credential. Per-agent keys still override it.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PATCHHIVE_AI_URL=http://127.0.0.1:8787/v1
# Required by both local gateways and their PatchHive product callers, including
# on loopback. Use the same scoped value for the gateway and authorized callers.
# PATCHHIVE_AI_GATEWAY_API_KEY=
# The unified backend starts a configured loopback gateway automatically.
# Set false only when another process manager owns @patchhive/ai-local.
# PATCHHIVE_AI_AUTOSTART=true
# Optional Node executable override for source-checkout autostart.
# PATCHHIVE_AI_NODE_PATH=node
# FailGuard persists raw candidates before this optional review-only semantic pass.
# REPO_MEMORY_FAILGUARD_AI_ENABLED=true
# REPO_MEMORY_FAILGUARD_AI_MODEL=gpt-5.4-mini
# REPO_MEMORY_FAILGUARD_AI_TIMEOUT_SECS=30
# REPO_MEMORY_FAILGUARD_AI_MAX_CALLS_PER_HOUR=20
# Optional Codex executable override; normally the package-owned CLI is used.
# PATCHHIVE_AI_CODEX_CLI_PATH=
# Set false only to report Codex auth as explicitly not_observed.
# PATCHHIVE_AI_CODEX_AUTH_PROBE=true
# PATCHHIVE_AI_CORS_ORIGINS=http://localhost:5173,http://localhost:5183
# PATCHHIVE_AI_MAX_BODY_BYTES=1048576
OLLAMA_BASE_URL=http://localhost:11434
COST_BUDGET_USD=0
MIN_REVIEW_CONFIDENCE=40
RETRY_COUNT=3
REAPER_MAX_ACTIVE_WORKERS=3
REAPER_ENABLE_UNTRUSTED_TESTS=false
# REAPER_TEST_SANDBOX=docker
# REAPER_ALLOW_HOST_TESTS=false
# REAPER_TEST_TIMEOUT_SECONDS=600
# Optional standalone RepoReaper database path.
# REAPER_DB_PATH=/absolute/path/to/repo-reaper.db
REAPER_WORK_DIR=/tmp/repo-reaper
# REAPER_ENCRYPTION_KEY=

# ── Product-specific runtime settings ─────────────────────────────────────────
MERGE_KEEPER_REQUIRE_APPROVAL=true
SIGNAL_MARKER_REPO_LIMIT=10
# Required before RefactorScout may inspect local repositories. Use a
# colon-separated list when more than one root is allowed.
# REFACTOR_SCOUT_ALLOWED_ROOTS=/absolute/path/to/your/repositories
# REFACTOR_SCOUT_ALLOW_REMOTE_FS=false
# REFACTOR_SCOUT_CLONE_TIMEOUT_SECS=120

# HiveCore is integrated into patchhive-backend; this path is a standalone-launcher
# compatibility override when PATCHHIVE_DB_PATH is absent.
# HIVE_CORE_DB_PATH=/absolute/path/to/hive-core.db
# Model used for HiveCore's incident postmortem and run-failure drafts. The gateway
# itself is PATCHHIVE_AI_URL above; set PATCHHIVE_AI_API_KEY only when it is remote.
# HIVE_CORE_AI_MODEL=gpt-4o-mini
# How long HiveCore waits for a dispatched product action (seconds, 5-3600).
# Product runs are real work; the polling timeout is separate and stays short.
# HIVE_CORE_DISPATCH_TIMEOUT_SECS=600
# Lifetime of a pending or granted exact-dispatch approval (hours, 1-168).
# HIVECORE_APPROVAL_TTL_HOURS=24
# Lease for committed outbound-PR budget reservations (1-365 days).
# HIVECORE_COMMITTED_PR_LEASE_DAYS=30
# GitHub PR lifecycle reconciliation cadence (30-3600 seconds).
# HIVE_CORE_PR_RECONCILE_INTERVAL_SECONDS=300
# Durable fleet-launch lease, renewed before each host-control phase (60-3600 seconds).
# HIVE_CORE_FLEET_JOB_LEASE_SECONDS=300
# Proposal-only conductor cadence in seconds (30-86400).
# HIVE_CORE_CONDUCTOR_INTERVAL_SECS=300
# HIVE_CORE_SNAPSHOT_INTERVAL_SECONDS=30
# Canonical repository-owner opt-out feed and its shared synchronization secret.
# PATCHHIVE_OPT_OUT_FEED_URL=https://registry.patchhive.dev/v1/sync/repository-opt-outs
# PATCHHIVE_OPT_OUT_SYNC_KEY=
# HIVE_CORE_OPT_OUT_SYNC_INTERVAL_SECONDS=300
# Durable single-writer tick lease in seconds (30-600).
# HIVE_CORE_CONDUCTOR_LEASE_SECS=60
# Active mandates planned per tick (1-25).
# HIVE_CORE_CONDUCTOR_MAX_MANDATES_PER_TICK=10
# PATCHHIVE_AI_API_KEY=
# HIVECORE_ENCRYPTION_KEY=

# --- Suite control plane (patchhive-backend) ---
# Operator key for the suite API layer. The backend fails closed without it: every
# protected route returns 503 until a key exists.
#
# Easiest path — one password across every product AND the suite:
#   ./scripts/set-suite-api-key.sh
#
# Or bootstrap a generated key from localhost with POST /api/auth/generate-key, or
# from the HiveCore deck's session gate. Stored as a SHA-256 hash, never the key.
PATCHHIVE_SUITE_API_KEY_HASH=
